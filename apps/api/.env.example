# Copiar para .env. Valores default funcionam com o docker-compose da raiz.
NODE_ENV=development
API_PORT=3000

# Database (PostgreSQL) — mesmos nomes usados pelo docker-compose da raiz,
# evitando ter duas fontes de verdade.
# Se você já tem outro Postgres rodando na 5432 (ex.: stack da empresa),
# troque POSTGRES_PORT aqui E no .env da raiz (ex: 5433).
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=bebecare
POSTGRES_PASSWORD=bebecare_dev_pwd
POSTGRES_DB=bebecare

# JWT
# Gere algo como: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=troque_isso_em_producao_por_uma_chave_aleatoria_longa
# Access token curto — refresh token cobre conveniência
JWT_ACCESS_EXPIRES_IN=15m
# Refresh token longo, rotativo, armazenado como sha256 no DB
JWT_REFRESH_EXPIRES_IN=30d

# Firebase Admin (preencher na fase 1.x, quando ativarmos push)
# FIREBASE_PROJECT_ID=
# FIREBASE_CLIENT_EMAIL=
# FIREBASE_PRIVATE_KEY=
