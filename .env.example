# .env da raiz — usado APENAS pelo docker-compose.
# Variáveis específicas da API ficam em apps/api/.env (copie de apps/api/.env.example).
# Copie este arquivo para .env e ajuste os valores se quiser.

# PostgreSQL — esses valores precisam bater com os do apps/api/.env
# Se você já tem outro Postgres rodando na 5432 (instalação local ou outro
# container), troque POSTGRES_PORT aqui E em apps/api/.env (ex: 5433).
POSTGRES_USER=bebecare
POSTGRES_PASSWORD=bebecare_dev_pwd
POSTGRES_DB=bebecare
POSTGRES_PORT=5432

# pgAdmin (opcional, só dev)
PGADMIN_EMAIL=admin@bebecare.local
PGADMIN_PASSWORD=admin
PGADMIN_PORT=5050
